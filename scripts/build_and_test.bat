@echo off
REM 简化的编译和测试脚本

echo ========================================
echo  编译并测试 anywp:// 协议
echo ========================================
echo.

REM 检查当前目录
if not exist "example" (
    echo ✗ 错误：请在项目根目录运行此脚本
    pause
    exit /b 1
)

REM 1. 准备测试文件
echo [1/3] 准备测试文件...
if not exist "%APPDATA%\AnyWP_Cache\images" (
    mkdir "%APPDATA%\AnyWP_Cache\images"
)

REM 创建简单的加密测试文件
PowerShell -Command "$bytes = [byte[]](0xFF,0xD8,0xFF,0xE0,0x00,0x10,0x4A,0x46,0x49,0x46,0x00,0x01,0x01,0x00,0x00,0x01,0x00,0x01,0x00,0x00,0xFF,0xDB,0x00,0x43,0x00,0x08,0x06,0x06,0x07,0x06,0x05,0x08,0x07,0x07,0x07,0x09,0x09,0x08,0x0A,0x0C,0x14,0x0D,0x0C,0x0B,0x0B,0x0C,0x19,0x12,0x13,0x0F,0x14,0x1D,0x1A,0x1F,0x1E,0x1D,0x1A,0x1C,0x1C,0x20,0x24,0x2E,0x27,0x20,0x22,0x2C,0x23,0x1C,0x1C,0x28,0x37,0x29,0x2C,0x30,0x31,0x34,0x34,0x34,0x1F,0x27,0x39,0x3D,0x38,0x32,0x3C,0x2E,0x33,0x34,0x32,0xFF,0xC0,0x00,0x0B,0x08,0x00,0x01,0x00,0x01,0x01,0x01,0x11,0x00,0xFF,0xC4,0x00,0x14,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x03,0xFF,0xC4,0x00,0x14,0x10,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xFF,0xDA,0x00,0x08,0x01,0x01,0x00,0x00,0x3F,0x00,0x37,0xFF,0xD9); [System.IO.File]::WriteAllBytes('%APPDATA%\AnyWP_Cache\images\test_jpeg_001.raw', $bytes)" 2>nul

PowerShell -Command "$raw = [System.IO.File]::ReadAllBytes('%APPDATA%\AnyWP_Cache\images\test_jpeg_001.raw'); for($i=0; $i -lt [Math]::Min(64, $raw.Length); $i++) { $raw[$i] = $raw[$i] -bxor 0x5A }; [System.IO.File]::WriteAllBytes('%APPDATA%\AnyWP_Cache\images\test_jpeg_001.encrypted', $raw)" 2>nul

del "%APPDATA%\AnyWP_Cache\images\test_jpeg_001.raw" 2>nul

if exist "%APPDATA%\AnyWP_Cache\images\test_jpeg_001.encrypted" (
    echo    ✓ 测试文件已创建
) else (
    echo    ✗ 测试文件创建失败
)
echo.

REM 2. 编译项目
echo [2/3] 编译项目（可能需要几分钟）...
cd example

call flutter clean
call flutter pub get
call flutter build windows --debug

if %ERRORLEVEL% neq 0 (
    echo.
    echo    ✗ 编译失败！
    echo.
    pause
    cd ..
    exit /b 1
)

cd ..
echo    ✓ 编译成功
echo.

REM 3. 启动应用
echo [3/3] 启动应用...

if not exist "example\build\windows\x64\runner\Debug\anywallpaper_engine_example.exe" (
    echo    ✗ 可执行文件不存在
    pause
    exit /b 1
)

echo.
echo ========================================
echo  🎯 测试说明
echo ========================================
echo.
echo 1. 应用即将启动
echo 2. 在应用的 Wallpaper 标签页中：
echo    - 输入 URL: file:///E:/Projects/AnyWallpaper/AnyWP-Test/examples/test_custom_scheme.html
echo    - 点击 "Start" 按钮启动壁纸
echo 3. 在测试页面中点击 "Run All Tests"
echo 4. 查看测试结果（绿色=成功，红色=失败）
echo.
echo 📂 测试文件位置：
echo    %APPDATA%\AnyWP_Cache\images\test_jpeg_001.encrypted
echo.
echo 🔍 预期结果：
echo    - anywp:// 协议成功拦截
echo    - 图片解密并显示
echo    - MIME Type 检测正确
echo.
echo ========================================
echo.
pause

start example\build\windows\x64\runner\Debug\anywallpaper_engine_example.exe

echo.
echo ✓ 应用已启动！
echo.
echo 按任意键退出此脚本...
pause >nul

