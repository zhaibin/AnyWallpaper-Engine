REM 加密文件（前64字节 XOR 0x5A）
PowerShell -Command "$raw = [System.IO.File]::ReadAllBytes('%APPDATA%\HKCW_Desktop\cache\images\test_jpeg_001.raw'); for($i=0; $i -lt [Math]::Min(64, $raw.Length); $i++) { $raw[$i] = $raw[$i] -bxor 0x5A }; [System.IO.File]::WriteAllBytes('%APPDATA%\HKCW_Desktop\cache\images\test_jpeg_001.encrypted', $raw)"

